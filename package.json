{
  "name": "trace",
  "version": "2026.8.16",
  "description": "Trace — a clipboard manager that lives on the left edge of your screen and expands on hover.",
  "author": "Trace",
  "license": "Apache-2.0",
  "private": true,
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:github": "npm run build && electron-builder --win nsis -c.extraMetadata.buildTarget=github",
    "build:store": "npm run build && electron-builder --win appx -c.extraMetadata.buildTarget=store",
    "build:msix": "npm run build && electron-builder --win appx -c.extraMetadata.buildTarget=store",
    "build:win": "npm run build:github",
    "package": "npm run build:github",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run"
  },
  "build": {
    "appId": "com.trace.app",
    "productName": "Trace",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "package.json",
      "!node_modules/@node-llama-cpp/win-x64-cuda{,/**/*}",
      "!node_modules/@node-llama-cpp/win-x64-cuda-ext{,/**/*}",
      "!node_modules/@node-llama-cpp/win-x64-vulkan{,/**/*}",
      "!node_modules/@node-llama-cpp/win-arm64{,/**/*}",
      "!node_modules/node-llama-cpp/llama/gitRelease.bundle"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/build/Release/*.node",
      "**/node_modules/@node-llama-cpp/win-x64/**/*",
      "**/node_modules/node-llama-cpp/bins/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "PaRr0tBoY",
      "repo": "Trace"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "appx",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Trace",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Trace-Setup-${version}.${ext}"
    },
    "appx": {
      "identityName": "Parrotboy.Trace",
      "publisher": "CN=55FECDC4-7144-4A41-98FC-056C003F76FD",
      "publisherDisplayName": "Trace",
      "applicationId": "Trace",
      "displayName": "Trace"
    }
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.11.30",
    "@types/react": "^18.2.73",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^34.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.1.0",
    "typescript": "^5.4.3",
    "vite": "^5.2.6",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@iconify-json/cuida": "^1.2.5",
    "@iconify/react": "^6.0.2",
    "@radix-ui/react-scroll-area": "^1.2.13",
    "@radix-ui/react-separator": "^1.1.11",
    "@resvg/resvg-js": "^2.6.2",
    "better-sqlite3": "^12.11.1",
    "electron-updater": "^6.8.9",
    "framer-motion": "^11.0.24",
    "gsap": "^3.15.0",
    "koffi": "^3.1.2",
    "lucide-react": "^1.26.0",
    "node-llama-cpp": "^3.20.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "svg-path-bbox": "^2.1.0",
    "zustand": "^4.5.2"
  },
  "allowScripts": {
    "electron@34.5.8": true,
    "koffi@3.1.4": true,
    "node-llama-cpp@3.20.0": true,
    "better-sqlite3@12.11.1": true
  }
}
